{
  "name": "expressive-charts",
  "version": "0.0.0",
  "description": "Composable motion and expressive effects for interactive web charts.",
  "license": "MIT",
  "author": "Deaversbp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deaversbp/expressive-charts.git"
  },
  "keywords": [
    "charts",
    "data-visualization",
    "animation",
    "motion",
    "svg",
    "dataviz"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icons/sport": {
      "types": "./dist/icons/sport.d.ts",
      "import": "./dist/icons/sport.js",
      "require": "./dist/icons/sport.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./style.css": "./dist/expressive-charts.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite demo",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p docs/sketches && tsc -p tests/visual",
    "test:visual": "playwright test",
    "test:visual:docker": "node tests/visual/docker.mjs",
    "test:visual:update": "node tests/visual/docker.mjs --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/d3-selection": "3.0.12",
    "@types/d3-shape": "3.2.0",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "jsdom": "^29.1.1",
    "tsup": "^9.0.0",
    "typescript": "^5.6.3",
    "vega": "6.4.0",
    "vega-lite": "6.5.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
