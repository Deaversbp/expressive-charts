{
  "name": "expressive-charts",
  "version": "0.1.0",
  "description": "Composable motion and expressive effects for interactive web charts.",
  "license": "MIT",
  "author": "Deaversbp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deaversbp/expressive-charts.git"
  },
  "homepage": "https://github.com/Deaversbp/expressive-charts#readme",
  "bugs": {
    "url": "https://github.com/Deaversbp/expressive-charts/issues"
  },
  "keywords": [
    "charts",
    "data-visualization",
    "animation",
    "motion",
    "svg",
    "dataviz",
    "d3",
    "vega",
    "observable-plot",
    "accessibility"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icons/sport": {
      "import": {
        "types": "./dist/icons/sport.d.ts",
        "default": "./dist/icons/sport.js"
      },
      "require": {
        "types": "./dist/icons/sport.d.cts",
        "default": "./dist/icons/sport.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./style.css": "./dist/expressive-charts.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite demo",
    "build": "tsup",
    "build:site": "vite build demo",
    "size": "node scripts/size.mjs",
    "pack-check": "node scripts/pack-check.mjs",
    "bench": "node scripts/bench.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p docs/sketches && tsc -p tests/visual && tsc -p scripts/media",
    "test:visual": "playwright test",
    "test:visual:docker": "node tests/visual/docker.mjs",
    "test:visual:update": "node tests/visual/docker.mjs --update-snapshots --project=chromium",
    "media": "node tests/visual/docker.mjs -c scripts/media/playwright.config.ts"
  },
  "devDependencies": {
    "@observablehq/plot": "0.6.17",
    "@playwright/test": "1.64.1",
    "@types/d3-selection": "3.0.12",
    "@types/d3-shape": "3.2.0",
    "axe-core": "4.14.0",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "jsdom": "^29.1.1",
    "tsup": "^9.0.0",
    "typescript": "5.9.3",
    "vega": "6.4.0",
    "vega-lite": "6.5.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
